# ── Wirasat environment configuration ──────────────────────────────
# Copy this file to .env and fill in real values. NEVER commit .env.

# Flask-style secret used to sign JWTs. Use a long random string:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-hex-string

# Database URL. SQLite works out of the box for dev/tests.
# For production use PostgreSQL (see docker-compose.yml):
#   DATABASE_URL=postgresql+psycopg://wirasat:wirasat@db:5432/wirasat
DATABASE_URL=sqlite:///./wirasat.db

# Comma-separated list of allowed CORS origins.
# For local dev with the SPA served from the same origin you can use "*".
CORS_ORIGINS=*

# Rate limits (slowapi): login/register attempts and general API.
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_GENERAL=120/minute

# Admin-only switch — if true, the /api/admin/danger/wipe endpoint is enabled.
# Keep false in production.
ENABLE_ADMIN_WIPE=false

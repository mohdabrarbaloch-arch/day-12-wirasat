{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/(css|js|.*\\.(png|jpg|svg|ico|webmanifest))", "dest": "/static/$1" },
    { "src": "/", "dest": "/static/index.html" }
  ]
}
